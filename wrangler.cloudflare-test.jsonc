{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "habicron-cloudflare-runtime-test",
  "main": "test/cloudflare/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "TEST_CLOCKS", "class_name": "TestClock" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestClock"] }]
}

{
  "name": "habicron",
  "type": "module",
  "version": "0.2.0",
  "description": "Schedule callbacks on randomized recurring intervals — habits, not cronjobs. Accurate by default, jittered on demand, with no drift. Works in Node, Vue, React, and the CLI.",
  "author": "thecodeorigin <nguyenhuunguyeny.ny@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/imrim12/habicron#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imrim12/habicron.git"
  },
  "bugs": {
    "url": "https://github.com/imrim12/habicron/issues"
  },
  "keywords": [
    "cron",
    "cronjob",
    "scheduler",
    "schedule",
    "interval",
    "setInterval",
    "jitter",
    "random",
    "habit",
    "recurring",
    "timer",
    "vue",
    "react",
    "composable",
    "hook",
    "cli"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.mjs",
      "require": "./dist/browser/index.cjs"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.mjs",
      "require": "./dist/vue/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/node/index.cjs",
  "module": "./dist/node/index.mjs",
  "types": "./dist/node/index.d.ts",
  "bin": {
    "habit": "./dist/cli/index.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/ecosystem-bootstrap.mjs build",
    "prepack": "unbuild",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:workspace": "unbuild"
  },
  "peerDependencies": {
    "react": "catalog:packages-habicron",
    "vue": "catalog:packages-habicron-2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:packages-habicron",
    "@eslint-react/eslint-plugin": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:packages-habicron",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:packages-habicron",
    "eslint": "catalog:packages-habicron",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:packages-habicron",
    "unbuild": "catalog:",
    "vitest": "catalog:packages-habicron",
    "vue": "catalog:packages-habicron",
    "vue-eslint-parser": "catalog:"
  }
}
